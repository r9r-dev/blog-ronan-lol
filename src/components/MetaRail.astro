---
import { formatRelativeDate, formatAbsoluteDate } from '../utils/relativeDate';

interface Props {
  date: Date;
  readTime?: number;
}

const { date, readTime } = Astro.props;
---

<aside class="meta-rail" aria-label="Informations">
  <div class="meta-rail-block">
    <p class="meta-rail-label">Date</p>
    <p class="meta-rail-value">{formatAbsoluteDate(date)}</p>
  </div>
  {readTime && (
    <div class="meta-rail-block">
      <p class="meta-rail-label">Lecture</p>
      <p class="meta-rail-value">{readTime} min</p>
    </div>
  )}
  <div class="meta-rail-block">
    <p class="meta-rail-label">Statut</p>
    <p class="meta-rail-value">Planté {formatRelativeDate(date)}</p>
  </div>
</aside>
