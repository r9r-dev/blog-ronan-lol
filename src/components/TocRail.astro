---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <aside class="toc-rail">
    <button class="toc-summary" type="button" aria-expanded="false" aria-controls="toc-body">
      <span class="toc-summary-label">Sommaire</span>
    </button>
    <p class="toc-title">Sommaire</p>
    <div class="toc-body" id="toc-body">
      <ol>
        {items.map((h) => (
          <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </aside>
)}

<script>
  const NARROW_BREAKPOINT = 1024;
  // Read the same sticky offset the CSS uses for `.toc-rail` (top: 6rem)
  const STICKY_TOP_REM = 6;

  function setupToc() {
    const rail = document.querySelector<HTMLElement>('.toc-rail');
    if (!rail) return;
    const summary = rail.querySelector<HTMLButtonElement>('.toc-summary');

    function isNarrow() {
      return window.matchMedia(`(max-width: ${NARROW_BREAKPOINT - 1}px)`).matches;
    }

    function stickyTopPx() {
      return STICKY_TOP_REM * parseFloat(getComputedStyle(document.documentElement).fontSize);
    }

    function syncCollapsed() {
      let collapsed = false;
      if (isNarrow()) {
        // narrow viewport: not sticky, render as inline accordion
        collapsed = true;
      } else {
        // wide viewport: collapse once the rail has actually started sticking
        const top = rail.getBoundingClientRect().top;
        collapsed = top <= stickyTopPx() + 1;
      }
      rail.classList.toggle('is-collapsed', collapsed);
      if (!collapsed) rail.classList.remove('is-expanded');
    }
    syncCollapsed();
    window.addEventListener('scroll', syncCollapsed, { passive: true });
    window.addEventListener('resize', syncCollapsed);

    summary?.addEventListener('click', () => {
      rail.classList.toggle('is-expanded');
      summary.setAttribute('aria-expanded', String(rail.classList.contains('is-expanded')));
    });

    // Scrollspy
    const links = rail.querySelectorAll<HTMLAnchorElement>('.toc-body a');
    const idToLink = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute('href')?.slice(1);
      if (id) idToLink.set(id, a);
    });
    const headings = Array.from(idToLink.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            idToLink.get(e.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));
  }
  document.addEventListener('astro:page-load', setupToc);
  if (document.readyState !== 'loading') setupToc();
</script>
