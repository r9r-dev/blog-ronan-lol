---
import BaseLayout from './BaseLayout.astro';
import TocRail from '../components/TocRail.astro';
import { formatRelativeDate, formatAbsoluteDate, readTimeMinutes } from '../utils/relativeDate';
import { stageGlyph, stageLabel } from '../utils/growthStage';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface NoteEntry { num: number; html: string; }

interface Props {
  post: CollectionEntry<'garden'> | CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  body: string;
  notes?: NoteEntry[];
}

const { post, headings, body, notes = [] } = Astro.props;
const { data, collection } = post;
const isGarden = collection === 'garden';

const readTime = (data as any).readTime ?? readTimeMinutes(body);
const plantedRel = formatRelativeDate(data.date);
const plantedAbs = formatAbsoluteDate(data.date);
const tendedRel = isGarden && (data as any).lastTended ? formatRelativeDate((data as any).lastTended) : null;

const backHref = isGarden ? '/jardin' : '/articles';
const backLabel = isGarden ? 'Retour au jardin' : 'Retour aux articles';

const stage = isGarden ? ((data as any).growthStage as 'seedling' | 'budding' | 'evergreen' | undefined) : null;
const articleType = !isGarden ? ((data as any).type as string | undefined) : null;

const notesJSON = JSON.stringify(notes);
---

<BaseLayout title={data.title} description={data.excerpt}>
  <article class:list={['article-grid', { 'has-notes': notes.length > 0 }]}>

    <header class="article-header">
      <a href={backHref} class="back-button">{backLabel}</a>
      <p class="article-eyebrow">
        {isGarden && stage ? (
          <span class={`stage stage--${stage}`}>{stageGlyph(stage)} {stageLabel(stage)}</span>
        ) : (
          <span class="type">{articleType}</span>
        )}
        {!isGarden && (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <span class="read-time">{readTime} min de lecture</span>
          </>
        )}
      </p>
      <h1>{data.title}</h1>
      {data.excerpt && <p class="article-dek" set:html={data.excerpt} />}
      <div class="article-meta">
        {data.tags && data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((tag: string) => (
              <a class="tag" href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}>{tag}</a>
            ))}
          </div>
        )}
        <div class="dates">
          <span title={plantedAbs}>Planté {plantedRel}</span>
          {tendedRel && <><br /><span>Arrosé {tendedRel}</span></>}
        </div>
      </div>
    </header>

    <TocRail headings={headings} />

    <div class="post-content" data-notes={notesJSON}>
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  function injectSidenotes() {
    const root = document.querySelector<HTMLElement>('.post-content');
    if (!root) return;
    let notes: Array<{ num: number; html: string }> = [];
    try { notes = JSON.parse(root.dataset.notes || '[]'); } catch { return; }
    if (notes.length === 0) return;
    const map = new Map(notes.map((n) => [String(n.num), n.html]));
    root.querySelectorAll<HTMLElement>('.sidenote-ref').forEach((ref) => {
      if (ref.dataset.injected) return;
      const num = ref.textContent?.trim();
      if (!num) return;
      const html = map.get(num);
      if (!html) return;
      const aside = document.createElement('aside');
      aside.className = 'sidenote-body';
      aside.id = `sidenote-${num}`;
      aside.innerHTML = `<span class="num">${num}</span>${html}`;
      ref.insertAdjacentElement('afterend', aside);
      ref.dataset.injected = '1';
    });
  }

  document.addEventListener('astro:page-load', injectSidenotes);
  if (document.readyState !== 'loading') injectSidenotes();
</script>
