---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Recherche — ronan.lol" description="Cherche dans le carnet.">
  <header class="page-header">
    <p class="page-eyebrow">Recherche plein-texte</p>
    <h1 class="page-title">Recherche</h1>
    <p class="page-dek">Tape un mot, une idée, un nom. Pagefind cherche dans tout le carnet.</p>
  </header>

  <div id="search" class="pagefind-host"></div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline define:vars={{}}>
    function initSearch() {
      // Pagefind ships an unbundled UI global
      if (typeof window.PagefindUI === 'undefined') return;
      if (document.querySelector('#search .pagefind-ui')) return;
      new window.PagefindUI({ element: '#search', resetStyles: false, showImages: false });
    }
    document.addEventListener('astro:page-load', initSearch);
    if (document.readyState !== 'loading') initSearch();
  </script>
</BaseLayout>
